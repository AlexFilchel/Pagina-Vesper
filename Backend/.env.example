# =======================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA VESPER
# Copia este archivo a .env y rellena con tus valores.
# El archivo .env NO debe subirse a Git.
# =======================================================

# AUTH0
AUTH0_ISSUER_URI=https://vesperarg.us.auth0.com/
AUTH0_AUDIENCE=https://verper/api

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

# DATABASE (MySQL)
DB_URL=jdbc:mysql://localhost:3306/db_vesper?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=tu_contraseña_de_mysql

# EMAIL
MAIL_USERNAME=tu_email_de_gmail@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion_de_google

# CLOUDINARY
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# MERCADO PAGO
MERCADOPAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_PRUEBA_O_PRODUCCION
MERCADOPAGO_BASE_URL=https://tu-url-de-ngrok.ngrok-free.app
