# ===============================
# = AUTH0 CONFIG
# ===============================
AUTH0_ISSUER_URI=https://vesperarg.us.auth0.com/
AUTH0_AUDIENCE=https://verper/api

# ===============================
# = CORS
# ===============================
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

# ===============================
# = DATA SOURCE (MySQL)
# ===============================
DB_URL=jdbc:mysql://localhost:3306/db_vesper?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=secret

# ===============================
# = JWT
# ===============================
JWT_SECRET=dummy_secret_change_me
JWT_EXPIRATION=604800000

# ===============================
# = SERVER
# ===============================
SERVER_PORT=8080

# ===============================
# = EMAIL
# ===============================
MAIL_USERNAME=dummy@gmail.com
MAIL_PASSWORD=dummy_password

# ===============================
# CLOUDINARY CONFIG
# ===============================
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# ===============================
# MERCADO PAGO
# ===============================
MP_ACCESS_TOKEN=APP_USR-dummy-access-token
MP_BASE_URL=https://dummy-url.ngrok-free.dev
MP_WEBHOOK_SECRET=dummy_webhook_secret
MP_PUBLIC_KEY=APP_USR-dummy-public-key

# ===============================
# FRONTEND & PUBLIC URLS
# ===============================
FRONTEND_BASE_URL=http://127.0.0.1:5500/Frontend
APP_PUBLIC_URL=https://dummy-url.ngrok-free.dev

# ===============================
# UALA CONFIG
# ===============================
UALA_USERNAME=dummy_uala_username
UALA_CLIENT_ID=dummy_uala_client_id
UALA_CLIENT_SECRET=dummy_uala_client_secret
